# Server Environment Configuration
NODE_ENV=development
PORT=5000

# Database
MONGODB_URI=mongodb://127.0.0.1:27017/zlice_db
REDIS_URI=redis://127.0.0.1:6379

# JWT Cryptographic Secrets (Use 256-bit+ secure random keys in production)
JWT_ACCESS_SECRET=zlice_super_secret_access_jwt_key_2026_xyz!
JWT_REFRESH_SECRET=zlice_super_secret_refresh_jwt_key_2026_abc!
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_EXPIRATION_DAYS=7

# Security & CORS
BCRYPT_SALT_ROUNDS=10
CORS_ORIGIN=http://localhost:3000,http://localhost:5173
COOKIE_SECRET=zlice_cookie_secret_key_9876543210
